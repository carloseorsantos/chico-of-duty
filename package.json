{
  "name": "chico-of-duty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chico of Duty \u2014 FPS 3D multiplayer felino no navegador",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "client": "vite",
    "server": "node server/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && npm test && vite build",
    "start": "NODE_ENV=production node server/server.ts",
    "sfx": "node scripts/gen-sfx.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
